# ── Raw & intermediate data (proprietary / DVC-tracked) ──────────────────────
# The raw Excel file is proprietary — never commit it
Pune Real Estate Data.xlsx
# DVC pipeline intermediate outputs — tracked by DVC, not Git
data_cleaned.csv
model_features.csv
model_target.npy

# ── NLTK downloaded corpora ───────────────────────────────────────────────────
# Downloaded automatically at runtime; no need to commit
nltk_data/

# ── MLflow local store ────────────────────────────────────────────────────────
mlruns/
mlflow.db
mlflow.db-journal
mlartifacts/

# ── DVC ───────────────────────────────────────────────────────────────────────
# Never commit the DVC cache, tmp files, or local remote config
.dvc/cache/
.dvc/tmp/
.dvc/config.local
dvc_remote/

# ── PyCaret / AutoML leftovers ────────────────────────────────────────────────
logs.log
catboost_info/

# ── Jupyter notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Temporary / misc ──────────────────────────────────────────────────────────
